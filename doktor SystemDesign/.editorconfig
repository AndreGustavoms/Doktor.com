# EditorConfig - alinhado com .gitattributes deste repo.
# Ver https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
indent_style = space
indent_size = 4

# .cmd usa CRLF (espelha .gitattributes)
[*.cmd]
end_of_line = crlf

# Markdown: nao aparar espaco no fim (dois espacos = quebra de linha proposital)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
