{
  "name": "painel-github",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Painel local de gestão dos meus repositórios GitHub — roda exclusivamente em 127.0.0.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "dev:https": "next dev -H 127.0.0.1 -p 3000 --experimental-https",
    "build": "next build && tsx scripts/check-bundle-secrets.ts",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sec": "vitest run tests/security",
    "audit": "npm audit --audit-level=high",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:backup": "tsx scripts/backup.ts",
    "check": "npm run lint && npm run test && npm run audit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "@octokit/rest": "^21.1.0",
    "@octokit/plugin-throttling": "^9.6.0",
    "@octokit/plugin-retry": "^7.2.0",
    "zod": "^3.24.0",
    "@tanstack/react-query": "^5.90.0",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.0",
    "remark-rehype": "^11.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-highlight": "^7.0.0",
    "rehype-stringify": "^10.0.0",
    "unist-util-visit": "^5.0.0",
    "server-only": "^0.0.1",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "lucide-react": "^0.469.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/hast": "^3.0.4",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.10",
    "@vitejs/plugin-react": "^4.3.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.0",
    "lefthook": "^1.9.0",
    "tsx": "^4.19.0"
  }
}
