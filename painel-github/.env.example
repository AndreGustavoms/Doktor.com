# Copie para .env.local e preencha. NUNCA commite .env.local — está no .gitignore.
#
# Modo de desenvolvimento apenas: o painel pode ler o token diretamente daqui
# em vez do vault cifrado. Quando esse modo está ativo, a UI exibe um aviso
# vermelho persistente. Não use este caminho fora de desenvolvimento local.
# Veja docs/SETUP.md para os escopos exatos exigidos pelo fine-grained PAT.
GITHUB_TOKEN=github_pat_cole_o_seu_token_aqui_nao_e_um_valor_real

# Porta do servidor. O painel SEMPRE escuta em 127.0.0.1 — ver docs/SECURITY.md §4.1.
PORT=3000

# Habilita ações destrutivas na UI (arquivar repo, forçar push, alternar
# visibilidade). Fica desabilitado por padrão — ver docs/SECURITY.md §4.13.
ALLOW_DESTRUCTIVE=false

# Define automaticamente quando certs/ (mkcert) está presente — não defina manualmente.
# HTTPS_ENABLED=false
